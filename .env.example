# ---- Servo environment variables ----
# Copy to .env and fill in. NEVER commit .env.

# --- Flare RPCs ---
FLARE_RPC=https://flare-api.flare.network/ext/C/rpc
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
# Chain id of the deployment target (Coston2 = 114)
SERVO_CHAIN_ID=114

# --- Contracts ---
CONTRACT_REGISTRY=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
# Deployed Servo contracts (from forge script Deploy.s.sol output)
SERVO_REGISTRY=
SERVO_CONTROLLER=
# FXRP (Coston2 testnet default; mainnet 0xAd552A648C74D49E10027AB8a618A3ad4901c5bE)
FXRP=0x0b6A3645c240605887a5532109323A3E12273dc7

# --- FDC verifier (attestation requests; key = all zeros) ---
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FDC_VERIFIER_KEY=00000000-0000-0000-0000-000000000000
# Coston2 DA endpoint (da-testnet.flare.network 404s for Coston2 rounds)
FDC_DA_URL=https://ctn2-data-availability.flare.network
# XRPL source id: "testXRP" for testnet, "XRP" for mainnet
FDC_SOURCE_ID=testXRP

# --- Relayer (watcher/agent signing) ---
RELAYER_PK=

# --- XRPL ---
# XRPL address the user pays to (watcher watches this for payments)
XRPL_RECEIVING_ADDRESS=
XRPL_WSS=wss://s.altnet.rippletest.net:51233
# Destination tag the watcher expects (uint32)
XRPL_DESTINATION_TAG=

# --- Yield venues (adapters on the deployed controller) ---
VENUE_STXRP_ADAPTER=
VENUE_EARNXRP_ADAPTER=

# --- Agent ---
# Confidence threshold for auto-execution (0-100)
AGENT_CONFIDENCE_THRESHOLD=70
# Price samples kept for realized APY (one per indexer run)
AGENT_APY_LOOKBACK_DAYS=30
WATCHER_PORT=9100 # watcher /health port
